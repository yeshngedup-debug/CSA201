# ── Frontend (Vite) ───────────────────────────────────────────────────
# Base URL of the Java API, INCLUDING the /api suffix.
#
# Local development: leave this unset (or use the value below) — the app
# defaults to http://localhost:8090/api, which is what `backend\run.bat`
# listens on.
#
# Deployed (Vercel → Project → Settings → Environment Variables):
#   VITE_API_URL = https://<your-api-host>/api
#
# Vite inlines this at BUILD time, so it must be set before the build runs
# and the site must be redeployed after changing it.
#
# Copy this file to `.env.local` to override it locally (`.env.local` is
# git-ignored; this example file is committed).

VITE_API_URL=http://localhost:8090/api
